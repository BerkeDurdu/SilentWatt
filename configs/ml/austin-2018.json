    "weather_timestamp": "time",
    "temperature": "temperature_2m (°C)"
  },
  "target_dead_band": 0.01,
  "analysis_window_utc": {
    "start": "2018-01-01T06:00:00Z",
    "end": "2019-01-01T06:00:00Z"
  },
  "splits_local_date": {
    "train": ["2018-01-01", "2018-06-01"],
    "calibration": ["2018-06-01", "2018-07-01"],
