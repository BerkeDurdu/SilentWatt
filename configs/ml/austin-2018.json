    "electric_15m": "15minute_data_austin.csv",
    "weather": "open-meteo-30.26N97.69W157m.csv"
  },
  "columns": {
    "household_id": "dataid",
    "timestamp_1m": "localminute",
    "timestamp_15m": "local_15min",
