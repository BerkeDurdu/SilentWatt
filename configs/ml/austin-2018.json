    "quantiles": [0.05, 0.5, 0.95]
  },
  "p1": {
    "protocol_version": "p1-v2",
    "daily_quality": {
      "minimum_coverage": 0.95,
      "frozen_run_slots": 16,
      "block_frozen_days": true
    },
    "calibration": {
      "alpha": 0.1,
      "minimum_days": 14,
      "minimum_slots": 1000
    },
    "quantile_model": {
      "max_iter": 100,
      "max_leaf_nodes": 15,
      "min_samples_leaf": 20,
      "learning_rate": 0.1,
      "random_state": 42
    }
  }
