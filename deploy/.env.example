# Copy to deploy/.env on the server and fill in. Never commit the real file; make it readable by root only:
#   chmod 600 deploy/.env

# Public name of the console. A domain gets an automatic HTTPS certificate; ":80" is plain HTTP for a first check.
SILENTWATT_SITE=silentwatt.example.com

# Image to run: built on the server (default) or pulled from SWR, e.g.
# swr.tr-west-1.myhuaweicloud.com/silentwatt/console:2026-10-14
SILENTWATT_IMAGE=silentwatt-console:latest

# Local PostgreSQL in the compose file. Use a long random password.
POSTGRES_PASSWORD=

# Managed database instead (RDS for PostgreSQL / GaussDB); leave empty to use the local one.
# A database on another host needs TLS: download the RDS CA certificate and mount it (the console refuses
# to start without it, unless SILENTWATT_DATABASE_TLS=off is set on purpose).
# SILENTWATT_DATABASE_URL=postgres://silentwatt:<password>@<private-ip>:5432/silentwatt
# SILENTWATT_DATABASE_CA=/config/rds-ca.pem

# Encrypts the nightly database backup (deploy/scripts/backup-db.sh). Long and random; keep a copy
# outside the VM, because a backup cannot be opened without it.
BACKUP_PASSPHRASE=

# Detector output on the host (synced from OBS by deploy/scripts/sync-evidence.sh).
SILENTWATT_EVIDENCE_HOST_DIR=/srv/silentwatt/evidence
# To show the committed synthetic fixtures instead, uncomment:
# SILENTWATT_EVIDENCE_DIR=/app/shared/fixtures/evidence

# Demo accounts share a password. Keep "off" on the internet; "on" only for a closed demo, and then with a
# password of your own (the console refuses to start in production with the default from the README).
SILENTWATT_DEMO_ACCOUNTS=off
# SILENTWATT_DEMO_PASSWORD=

# Residents' links and requests: days a link stays valid, days a request (name, phone, address) is kept.
# SILENTWATT_RESIDENT_LINK_DAYS=30
# SILENTWATT_REQUEST_RETENTION_DAYS=180
# Minutes of inactivity after which a signed-in session ends.
# SILENTWATT_SESSION_IDLE_MINUTES=30

# Case assistant (docs/architecture/api.md, "Vaka asistanı"). Off unless set. Huawei Cloud ModelArts Studio
# (MaaS) serves Qwen and DeepSeek over an OpenAI-compatible API: copy the base URL (ending in /v1), the
# model name and an API key from its console.
# SILENTWATT_LLM_PROVIDER=openai
# SILENTWATT_LLM_BASE_URL=
# SILENTWATT_LLM_MODEL=
# SILENTWATT_LLM_API_KEY=

# OBS bucket for evidence and database backups (used by the scripts, not by the console).
OBS_BUCKET=silentwatt-data
