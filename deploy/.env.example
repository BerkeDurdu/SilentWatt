# Copy to deploy/.env on the server and fill in. Never commit the real file.

# Public name of the console. A domain gets an automatic HTTPS certificate; ":80" is plain HTTP for a first check.
SILENTWATT_SITE=silentwatt.example.com

# Image to run: built on the server (default) or pulled from SWR, e.g.
# swr.tr-west-1.myhuaweicloud.com/silentwatt/console:2026-10-14
SILENTWATT_IMAGE=silentwatt-console:latest

# Local PostgreSQL in the compose file. Use a long random password.
POSTGRES_PASSWORD=

# Managed database instead (RDS for PostgreSQL / GaussDB); leave empty to use the local one.
# SILENTWATT_DATABASE_URL=postgres://silentwatt:<password>@<private-ip>:5432/silentwatt
# SILENTWATT_DATABASE_CA=/config/rds-ca.pem

# Detector output on the host (synced from OBS by deploy/scripts/sync-evidence.sh).
SILENTWATT_EVIDENCE_HOST_DIR=/srv/silentwatt/evidence
# To show the committed synthetic fixtures instead, uncomment:
# SILENTWATT_EVIDENCE_DIR=/app/shared/fixtures/evidence

# Demo accounts share a public password. Keep "off" on the internet; "on" only for a closed demo.
SILENTWATT_DEMO_ACCOUNTS=off

# OBS bucket for evidence and database backups (used by the scripts, not by the console).
OBS_BUCKET=silentwatt-data
